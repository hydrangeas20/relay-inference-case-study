# Copy to .env and adjust. Defaults point at the local Docker stack.

# Inference endpoint: the simulator locally, or a real vLLM server on a rented GPU.
INFERENCE_BASE_URL=http://localhost:8000/v1
INFERENCE_METRICS_URL=http://localhost:8000/metrics
INFERENCE_BACKEND=sim            # sim | gpu (tags every result with its source)
COMPLETION_MODEL=relay/code-7b
EMBEDDING_MODEL=relay/embed-small

# Customer AWS: Floci locally. Credentials can be any non-empty value for Floci.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Relay's gateway, as seen by the load generator.
GATEWAY_URL=http://localhost:8080

# Indexing worker: maximum jobs in flight at once (decision 6B).
WORKER_MAX_IN_FLIGHT=8
