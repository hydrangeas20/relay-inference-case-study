# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment
.env

# Local code corpus (built by `make corpus` from corpus/repos.toml)
data/

# Generated traces can be hundreds of MB; only the smoke trace is committed.
traces/*.jsonl
!traces/smoke.jsonl

# Raw per-request traces can be large; summaries in results/ are committed.
results/raw/

# Generated site output
site/_build/

# OS / editors
.DS_Store
.idea/
.vscode/
